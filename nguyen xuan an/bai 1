using System;
using System.Globalization;
using System.Windows.Forms;

namespace ServiceChargeCalculator
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();

            // Đảm bảo ô Giảm giá luôn cho phép nhập liệu khi mở Form
            txtPhanTramGiam.Enabled = true;
            txtPhanTramGiam.ReadOnly = false;
        }

        // Sự kiện khi bấm nút "Tính tiền" (btnTinhTien)
        private void btnTinhTien_Click(object sender, EventArgs e)
        {
            // 1. Validate Đơn giá dịch vụ
            if (!decimal.TryParse(txtDonGia.Text.Trim(), out decimal donGia) || donGia < 0)
            {
                MessageBox.Show("Vui lòng nhập Đơn giá dịch vụ là số lớn hơn hoặc bằng 0!",
                                "Lỗi nhập liệu", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtDonGia.Focus();
                txtDonGia.SelectAll();
                return;
            }

            // 2. Validate Số lượng khách
            if (!int.TryParse(txtSoLuong.Text.Trim(), out int soLuong) || soLuong <= 0)
            {
                MessageBox.Show("Vui lòng nhập Số lượng khách là số nguyên dương (> 0)!",
                                "Lỗi nhập liệu", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtSoLuong.Focus();
                txtSoLuong.SelectAll();
                return;
            }

            // 3. Validate Phần trăm giảm giá (%)
            string giamGiaInput = string.IsNullOrWhiteSpace(txtPhanTramGiam.Text) ? "0" : txtPhanTramGiam.Text.Trim();
            if (!decimal.TryParse(giamGiaInput, out decimal phanTramGiam) || phanTramGiam < 0 || phanTramGiam > 100)
            {
                MessageBox.Show("Vui lòng nhập Phần trăm giảm giá từ 0 đến 100!",
                                "Lỗi nhập liệu", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtPhanTramGiam.Focus();
                txtPhanTramGiam.SelectAll();
                return;
            }

            // 4. Tính toán tổng tiền
            decimal tongTien = (donGia * soLuong) * (100 - phanTramGiam) / 100m;

            // 5. Hiển thị kết quả (định dạng dấu phân cách hàng nghìn VNĐ)
            lblTongTien.Text = string.Format(new CultureInfo("vi-VN"), "{0:N0} VNĐ", tongTien);
        }

        // Sự kiện khi bấm nút "Làm mới" (btnLamMoi)
        private void btnLamMoi_Click(object sender, EventArgs e)
        {
            txtDonGia.Clear();
            txtSoLuong.Clear();
            txtPhanTramGiam.Text = "0";
            lblTongTien.Text = "0 VNĐ";

            txtDonGia.Focus();
        }
    }
}
