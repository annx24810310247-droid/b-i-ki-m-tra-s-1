using System;
using System.Windows.Forms;

namespace bai_3
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            cboDVT.Items.Clear();
            cboDVT.Items.AddRange(new string[] { "Cái", "Bộ", "Kg", "Mét" });
            cboDVT.SelectedIndex = 0;
        }

        private bool KiemTraTrungMa(string maVT)
        {
            foreach (ListViewItem item in lsvVatTu.Items)
            {
                if (item.Text.Equals(maVT, StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }
            return false;
        }

        private void ClearInput()
        {
            txtMaVT.Clear();
            txtTenVT.Clear();
            txtDonGia.Clear();
            if (cboDVT.Items.Count > 0) cboDVT.SelectedIndex = 0;
            txtMaVT.Enabled = true;
            txtMaVT.Focus();
        }

        private void btnThem_Click(object sender, EventArgs e)
        {
            string maVT = txtMaVT.Text.Trim();
            string tenVT = txtTenVT.Text.Trim();
            string donGiaStr = txtDonGia.Text.Trim();

            if (string.IsNullOrEmpty(maVT) || string.IsNullOrEmpty(tenVT) || string.IsNullOrEmpty(donGiaStr))
            {
                MessageBox.Show("Vui lòng nhập đầy đủ thông tin vật tư!", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (KiemTraTrungMa(maVT))
            {
                MessageBox.Show($"Mã vật tư '{maVT}' đã tồn tại trong danh sách!", "Lỗi nhập liệu", MessageBoxButtons.OK, MessageBoxIcon.Error);
                txtMaVT.Focus();
                return;
            }

            if (!decimal.TryParse(donGiaStr, out decimal donGia) || donGia < 0)
            {
                MessageBox.Show("Đơn giá nhập phải là số hợp lệ!", "Lỗi định dạng", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtDonGia.Focus();
                return;
            }

            ListViewItem item = new ListViewItem(maVT);
            item.SubItems.Add(tenVT);
            item.SubItems.Add(cboDVT.SelectedItem.ToString());
            item.SubItems.Add(donGia.ToString("#,##0"));

            lsvVatTu.Items.Add(item);
            ClearInput();
        }

        private void btnCapNhat_Click(object sender, EventArgs e)
        {
            if (lsvVatTu.SelectedItems.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn 1 dòng vật tư trong danh sách để cập nhật!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            string tenVT = txtTenVT.Text.Trim();
            string donGiaStr = txtDonGia.Text.Trim();

            if (string.IsNullOrEmpty(tenVT) || string.IsNullOrEmpty(donGiaStr))
            {
                MessageBox.Show("Vui lòng nhập Tên vật tư và Đơn giá!", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!decimal.TryParse(donGiaStr, out decimal donGia) || donGia < 0)
            {
                MessageBox.Show("Đơn giá nhập phải là số hợp lệ!", "Lỗi định dạng", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                txtDonGia.Focus();
                return;
            }

            ListViewItem selectedItem = lsvVatTu.SelectedItems[0];
            selectedItem.SubItems[1].Text = tenVT;
            selectedItem.SubItems[2].Text = cboDVT.SelectedItem.ToString();
            selectedItem.SubItems[3].Text = donGia.ToString("#,##0");

            MessageBox.Show("Cập nhật thông tin vật tư thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
            ClearInput();
        }

        private void btnXoaDong_Click(object sender, EventArgs e)
        {
            if (lsvVatTu.SelectedItems.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn dòng cần xóa!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            ListViewItem selectedItem = lsvVatTu.SelectedItems[0];
            DialogResult dr = MessageBox.Show(
                $"Bạn có chắc chắn muốn xóa vật tư '{selectedItem.SubItems[1].Text}' (Mã: {selectedItem.Text}) không?",
                "Xác nhận xóa",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Question
            );

            if (dr == DialogResult.Yes)
            {
                lsvVatTu.Items.Remove(selectedItem);
                ClearInput();
            }
        }

        private void btnXoaTatCa_Click(object sender, EventArgs e)
        {
            if (lsvVatTu.Items.Count == 0)
            {
                MessageBox.Show("Danh sách đang trống!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            DialogResult dr = MessageBox.Show(
                "Bạn có chắc chắn muốn xóa TOÀN BỘ danh sách vật tư không?",
                "Xác nhận xóa tất cả",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Warning
            );

            if (dr == DialogResult.Yes)
            {
                lsvVatTu.Items.Clear();
                ClearInput();
            }
        }

        private void lsvVatTu_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (lsvVatTu.SelectedItems.Count > 0)
            {
                ListViewItem item = lsvVatTu.SelectedItems[0];
                txtMaVT.Text = item.Text;
                txtTenVT.Text = item.SubItems[1].Text;
                cboDVT.SelectedItem = item.SubItems[2].Text;

                string donGiaClean = item.SubItems[3].Text.Replace(",", "").Replace(".", "");
                txtDonGia.Text = donGiaClean;

                txtMaVT.Enabled = false;
            }
            else
            {
                txtMaVT.Enabled = true;
            }
        }
    }
}
