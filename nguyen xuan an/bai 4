namespace bai_4
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // 1. Thêm khung giờ
            cboKhungGio.Items.Add("Sáng (100.000đ)");
            cboKhungGio.Items.Add("Tối (150.000đ)");
            cboKhungGio.SelectedIndex = 0;

            // 2. Dùng vòng lặp for tạo 20 Button
            for (int i = 1; i <= 20; i++)
            {
                Button btn = new Button
                {
                    Text = i.ToString(),
                    Width = 75,
                    Height = 45,
                    BackColor = Color.LightGray // Trắng/Xám: Trống
                };

                // Vị trí 3 và 8 giả định đã có người đặt trước (Màu đỏ, khóa nút)
                if (i == 3 || i == 8)
                {
                    btn.BackColor = Color.Red;
                    btn.Enabled = false;
                }
                else
                {
                    // Gán CHUNG 1 hàm xử lý Click cho toàn bộ 20 nút
                    btn.Click += Vitri_Click;
                }

                flpSoDo.Controls.Add(btn);
            }
        }

        // Sự kiện Click dùng chung cho các vị trí
        private void Vitri_Click(object sender, EventArgs e)
        {
            Button btn = (Button)sender;

            // Đổi màu qua lại: Xám (Trống) <-> Xanh lá (Đang chọn)
            if (btn.BackColor == Color.LightGray)
                btn.BackColor = Color.LightGreen;
            else if (btn.BackColor == Color.LightGreen)
                btn.BackColor = Color.LightGray;

            TinhTien();
        }

        // Hàm cập nhật số lượng vị trí chọn và tính tổng tiền
        private void TinhTien()
        {
            // Đếm số nút có màu Xanh lá
            int soLuong = flpSoDo.Controls.OfType<Button>().Count(b => b.BackColor == Color.LightGreen);
            int giaTien = cboKhungGio.SelectedIndex == 0 ? 100000 : 150000;

            lblSoViTri.Text = $"Số vị trí đang chọn: {soLuong}";
            lblTongTien.Text = $"Tạm tính tiền: {soLuong * giaTien:#,##0} VNĐ";
        }

        // Đổi khung giờ -> Tính lại tiền
        private void cboKhungGio_SelectedIndexChanged(object sender, EventArgs e)
        {
            TinhTien();
        }

        // Nút Xác nhận đặt
        private void btnXacNhan_Click(object sender, EventArgs e)
        {
            var dsDangChon = flpSoDo.Controls.OfType<Button>().Where(b => b.BackColor == Color.LightGreen).ToList();

            if (dsDangChon.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn ít nhất 1 vị trí!", "Thông báo");
                return;
            }

            // Chuyển các nút đang chọn thành Màu Đỏ và Khóa lại
            foreach (var btn in dsDangChon)
            {
                btn.BackColor = Color.Red;
                btn.Enabled = false;
            }

            MessageBox.Show("Đặt vị trí thành công!", "Thông báo");
            TinhTien();
        }

        // Nút Hủy chọn tất cả
        private void btnHuy_Click(object sender, EventArgs e)
        {
            foreach (var btn in flpSoDo.Controls.OfType<Button>().Where(b => b.BackColor == Color.LightGreen))
            {
                btn.BackColor = Color.LightGray;
            }
            TinhTien();
        }
    }
}
